{
  "expo": {
    "name": "GUNX SMART BUSINESS",
    "slug": "gunx-smart-business",
    "scheme": "gunxsmartbusiness",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gunx.smartbusiness"
    },
    "android": {
      "package": "com.gunx.smartbusiness"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/gunx-smart-business-logo-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#081522"
        }
      ]
    ]
  }
}