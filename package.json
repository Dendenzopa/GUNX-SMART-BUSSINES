    "react-native-web": "^0.21.0",
    "@supabase/supabase-js": "^2.57.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react-dom": "19.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo-print": "~15.0.7",
    "expo-sharing": "~14.0.7",
